// Database schema for the real backend (auth + persisted sessions + leaderboard).
// Provider is SQLite for local/self-hosted use; swap to "postgresql" when
// migrating to a hosted DB (see ROADMAP Phase 3).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id              String                 @id @default(cuid())
  username        String                 @unique
  email           String                 @unique
  passwordHash    String
  diamonds        Int                    @default(0)
  createdAt       DateTime               @default(now())
  authSessions    AuthSession[]
  tradingSessions TradingSessionRecord[]
  tradeCalls      TradeCall[]
  missionClaims   MissionClaim[]
}

// Opaque server-side auth session. Token is a random 256-bit hex string
// stored in an httpOnly cookie — revocable, no JWT secret to leak.
model AuthSession {
  token     String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// One completed simulation run (manual end or liquidation).
// Mirrors the endStats computed in src/app/trading/page.tsx.
// A "called shot": a declared take-profit target the player commits to at
// position open. The server is authoritative for diamond payouts — the reward
// is computed here (streak, cooldown, per-run cap), never trusted from the
// client. Verification of hit/miss by deterministic replay is R2 debt
// (see PRD_ROGUELIKE_PVP.md).
model TradeCall {
  id            String    @id @default(cuid())
  userId        String
  runId         String // client-generated per run; a real Run model is R2 debt
  side          String // "long" | "short"
  entryPrice    Float
  targetPrice   Float
  targetPercent Float
  leverage      Float
  status        String    @default("pending") // "pending" | "hit" | "missed" | "voided"
  reward        Int       @default(0)
  createdAt     DateTime  @default(now())
  resolvedAt    DateTime?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, runId])
}

// One claimed daily mission per user per UTC day (PRD_ROGUELIKE_PVP.md §6).
// The unique triple is the race backstop: a double-claim loses on insert
// (P2002) instead of paying diamonds twice. `day` is the "yyyy-mm-dd" UTC key
// from utcDayKey — the reset is midnight UTC for every player (fairness).
model MissionClaim {
  id        String   @id @default(cuid())
  userId    String
  missionId String
  day       String
  reward    Int
  claimedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, missionId, day])
}

model TradingSessionRecord {
  id             String   @id @default(cuid())
  userId         String
  endReason      String // "manual" | "liquidated"
  startingWallet Float
  finalWallet    Float
  pnl            Float
  returnPercent  Float
  trades         Int
  winRate        Float
  bestTrade      Float
  worstTrade     Float
  maxDrawdown    Float
  traderScore    Int
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
}
